<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Parte 7: Supresión de verificaciones -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <!-- Parte 6: Verificar encabezados -->
    <module name="Header">
        <property name="header" value="// Copyright (C) 2025"/>
        <property name="fileExtensions" value="java"/>
    </module>

    <!-- No usar tabulaciones para indentar -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- Parte 5: Método Javadoc -->
        <module name="JavadocMethod"/>
        <module name="MissingJavadocMethod">
            <property name="scope" value="private"/>
        </module>

        <!-- Parte 5: Nombre del método -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>

        <!-- Nombre de variables locales -->
        <module name="LocalVariableName"/>

        <!-- Parte 5: Espacio en blanco después de COMMA y SEMI -->
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA, SEMI"/>
        </module>

        <!-- Espacio alrededor de operadores como = + - * / -->
        <module name="WhitespaceAround"/>
    </module>
</module>
